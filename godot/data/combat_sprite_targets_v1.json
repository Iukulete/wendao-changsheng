  "schema_version": 1,
  "description": "统一角色资产目标清单：先用全局参考图锁定立绘画风，再按剧情身份生成并验收立绘，最后从通过身份门的立绘派生战斗精灵。帧数不设硬上限，4x4/16帧只是首轮可验收基线。",
  "global_target": {
    "portrait_first": "identity_card -> high_resolution_portrait -> identity_gate -> neutral_guard_attack -> pixel_atlas -> runtime_gate",
    "style_reference_policy": "用户提供的两张二次元战斗插画只决定线条、脸部完成度、头发、材质、光影和动态语言；不得复制其角色身份、服装、武器、饰物或构图",
    "style": "高密度16-bit手工像素画，硬边阶梯像素，有限调色板，深蓝轮廓，细密像素簇，不做Q版或大头小人",
    "palette": "整体低饱和、偏冷偏灰；默认主体像素饱和度中位数22%到32%，绝大多数低于45%，超过55%的像素仅占角色与特效面积8%到12%；白衣先读成玉白、银甲先读成冷灰，故事允许时才使用暗朱红/酒红点缀，禁止荧光蓝",
    "palette_gate": {
      "median_saturation_percent": [22, 32],
      "most_pixels_below_percent": 45,
      "high_saturation_area_percent_max": 12,
      "character_palette_colors": [26, 28],
      "effect_alpha_levels": [96, 160, 224, 255]
    },
    "transparency": "真透明RGBA PNG；主体以外、格间、地面光斑、雾光、渐变和纹理全部透明",
    "anatomy": "成年人完整全身，脚部不裁切；主角与成年女性默认约7.5到8头身，成年女性可有自然丰满的胸腰线与修长腿部来体现修仙者体态。成人女性按角色分为剧情克制档与成人向卖肉档：江照雪、男主及正经核心人物保持故事形象；明确成年且适合的反派或支线角色可用深V、大面积露上胸与肩锁骨、露背/侧腰、腿部开衩、贴身束带和姿态作为卖点，衣料保持不透明，不能出现明确性行为、露骨生殖器细节或未成年化体型；避免让全员使用同一档位。男主保持故事中的清瘦修长比例而不缩成小人；儿童永远使用独立的儿童比例和服装逻辑，不套用成人胸腰模板",
    "facing": "玩家角色面向右，敌方角色面向左；脸、武器和职业轮廓在战斗显示高度下可辨",
    "frame_policy": "idle、charge、guard、attack、spell、hit、defeat必须有可读动作变化；复杂剑诀、法术和终结技可扩展到32、64或128帧",
    "baseline_sheet": {"columns": 4, "rows": 4, "frames": 16},
    "acceptance": [
      "与身份立绘保持脸型、发型、服装剪影、武器和叙事年龄一致",
      "任何角色不得复用另一角色的脸、身体、服装或武器",
      "透明背景在导入Godot后不产生彩色雾框",
      "动作帧能映射到技能、受击、格挡和退场反馈"
    ]
  },
