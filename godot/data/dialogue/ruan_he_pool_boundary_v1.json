      "type": "effect",
      "effects": [
        {"type": "set_flag", "flag": "ruan_he_family_boundary_preserved", "value": true},
        {"type": "character_expression", "character_id": "ruan_he", "expression": "relieved"}
      ],
      "next": "rhe_end"
    },
