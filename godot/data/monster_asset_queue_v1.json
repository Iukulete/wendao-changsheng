{
  "schema_version": 1,
  "description": "按族群母版、身体原型、身份卡和动作模板生产怪物资产的可扩展队列；普通怪不强制先做1024x1536剧情立绘，Boss与关键精英才升级为完整概念立绘。",
  "production_policy": {
    "ordinary": "族群母版 + 单怪身份卡 + 标准战斗表",
    "elite": "族群母版 + 单怪身份卡 + Combat Core；有剧情镜头时再补全身立绘",
    "boss": "完整剧情概念立绘 + Identity Card + Combat Core + Skill/Phase表",
    "variant_rule": "同族变体至少改变3个剪影字段和2个材质字段；建议70%家族共享、30%个体变化，Boss反向为40%共享、60%独有",
    "hard_gates": ["silhouette", "body_archetype", "attack_organ_or_weapon", "frame_safe_bounds", "alpha", "in_game_readability"],
    "soft_gates": ["micro_texture", "minor_palette_tuning", "secondary_particles"]
  },
  "body_archetypes": {
    "HUM_L": {"label": "修长人形", "scale_contract": "7.0-8.0头身；窄肩长腿；适合人形敌人和远程敌人"},
    "HUM_H": {"label": "厚重人形", "scale_contract": "5.5-6.5头身；宽肩厚躯干；适合巨汉、重甲和工造敌人"},
    "QUAD_L": {"label": "轻型四足", "scale_contract": "低重心；前后肢差异明显；头部不放大"},
    "QUAD_H": {"label": "重型四足", "scale_contract": "肩胛与躯干占主剪影；攻击器官优先"},
    "FLOAT": {"label": "浮游型", "scale_contract": "无固定脚底；核心器官和漂浮轨迹稳定"},
    "AMORPH": {"label": "无定形", "scale_contract": "核心锚点固定；边缘形变可变；禁止伪装成人形"},
    "GIANT": {"label": "巨大型", "scale_contract": "独立巨汉/巨兽比例；单格允许占满高度但必须保留动作安全区"},
    "BOSS_SPECIAL": {"label": "特殊Boss", "scale_contract": "不受普通16帧限制；分Combat Core、Skill、Phase、Death表"}
  },
  "action_templates": {
    "HUM_MELEE": ["idle", "guard", "attack", "hit"],
