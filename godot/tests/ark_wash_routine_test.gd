extends SceneTree
const Routine = preload("res://scripts/modules/residents/ark_wash_routine.gd")
func _initialize() -> void:
	var policy = Routine.new()
	assert(policy.reconcile(["sailmaker","tidekeeper"]).owner == "tidekeeper")
	for index in 100: assert(not policy.advance(100000,["tidekeeper","sailmaker"],false).settle)
	assert(policy.elapsed_us == 0)
	for index in 10:
		policy.reconcile(["tidekeeper","sailmaker"])
		assert(not policy.advance(100000,["tidekeeper","sailmaker"],true).settle)
	assert(policy.elapsed_us == 1000000,"reconciling a target must not reset actual washing progress")
	assert(not policy.advance(100000,["tidekeeper","sailmaker"],false).settle and policy.elapsed_us == 0)
	for index in 7: assert(not policy.advance(250000,["tidekeeper","sailmaker"],true).settle)
	assert(policy.advance(250000,["tidekeeper","sailmaker"],true).settle)
	for index in 20: assert(not policy.advance(250000,["tidekeeper","sailmaker"],true).settle)
	assert(not policy.acknowledge("sailmaker",true).ok)
	assert(policy.acknowledge("tidekeeper",false).ok)
	assert(policy.advance(250000,["tidekeeper","sailmaker"],false).owner == "sailmaker")
	assert(policy.advance(250000,[],false).intent == "idle")
	var before: Dictionary = policy.view()
	for bad in [-1,250001]: assert(not policy.advance(bad,[],false).ok and policy.view() == before)
	assert(not policy.advance(1,["player"],false).ok and policy.view() == before)
	assert(not policy.reconcile(["sailmaker","sailmaker"]).ok and policy.view() == before)
	var a = Routine.new()
	var b = Routine.new()
	a.reconcile(["tidekeeper"])
	b.reconcile(["tidekeeper"])
	for index in 20: a.advance(100000,["tidekeeper"],true)
	for index in 8: b.advance(250000,["tidekeeper"],true)
	assert(a.view() == b.view() and a.phase == "settling")
	assert(a.acknowledge("tidekeeper",true).completed)
	assert(not a.acknowledge("tidekeeper",true).ok)
	assert(a.reconcile(["tidekeeper"]).changed and a.owner == "tidekeeper")
	a.cancel()
	assert(a.phase == "idle" and a.owner.is_empty() and a.elapsed_us == 0)
	print("ARK_WASH_ROUTINE_TEST_OK: bounded actors/one station, fair ownership, true-arrival time, reconcile preservation, interruption reset, exact-once settlement intent and acknowledgement")
	quit()
