.gitattributes text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.bat text eol=crlf

# Exact-byte preservation baselines must survive checkout on every platform.
/archive/** -text
/LICENSE -text
/godot/art/fonts/** -text
/godot/art/surface_sample/** -text
/godot/art/coast/** -text
/godot/art/coast_nature/** -text
/godot/art/ui_icons/** -text
/native/ark_simulation/third_party/flecs/** -text
/godot/tests/support/** -text
/godot/shaders/** -text

# Preserve pinned upstream bytes/style; do not reformat vendored sources/licenses.
/native/ark_simulation/third_party/flecs/flecs.[ch] -whitespace
/godot/art/coast_nature/License_Standard.txt -whitespace
/godot/art/coast_nature/asset_manifest.json whitespace=cr-at-eol

# High-poly character handoff sources are not runtime assets.
/art_source/characters/blue_qipao/f10/*.glb filter=lfs diff=lfs merge=lfs -text
/art_source/characters/blue_qipao/f10/*.blend filter=lfs diff=lfs merge=lfs -text
