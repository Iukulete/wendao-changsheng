      "type": "choice",
      "choices": [
        {
          "id": "ldu_choice_seize_old_records",
          "text": "传唤时一并保全退休私章、十一年前值班簿、冲突许可说明和授权复制器；先冻结新授权，分别核对签章、设备日志与实际操作者。",
          "next": "ldu_line_02",
          "effects": [
            {"type": "relation_delta", "character_id": "liang_du", "stat": "trust", "delta": 2},
            {"type": "set_flag", "flag": "liang_du_records_preserved", "value": true}
          ]
        },
        {
          "id": "ldu_choice_question_signature_only",
          "text": "先只询问私章来源，暂不保全设备与取件窗口；把责任收窄到签章本人，但承认操作链仍待补证。",
          "next": "ldu_line_02",
