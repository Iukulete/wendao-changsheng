      "type": "choice",
      "choices": [
        {
          "id": "md_choice_recorded_advance",
          "text": "先把生活预付、工伤证据、工牌保管和余款复核日分栏登记，立即支付可确认的生活额，不附带最终和解。",
          "next": "md_line_02",
          "effects": [
