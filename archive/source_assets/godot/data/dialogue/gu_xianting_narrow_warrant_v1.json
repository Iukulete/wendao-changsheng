      "type": "choice",
      "choices": [
        {
          "id": "gx_choice_split_permissions",
          "text": "把身份、医疗、设备日志和财产权限分成四栏，分别写期限、证据来源与到期后的下一位复核人。",
          "next": "gx_line_02",
          "effects": [
            {"type": "relation_delta", "character_id": "gu_xianting", "stat": "trust", "delta": 2},
