        }
      ]
    },
    {
      "id": "cya_line_02",
      "type": "line",
      "speaker_id": "protagonist",
      "expression": "gentle",
      "outfit": "default",
      "text": "岑芽可以记住谁陪她吃饭、哪盏灯亮着、该去哪里找人；城市的炉、债和排班由大人负责，不能把孩子的画变成替她签下的决定。",
