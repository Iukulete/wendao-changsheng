      "type": "choice",
      "choices": [
        {
          "id": "al_choice_harm_first",
          "text": "按伤情和停药风险排红黄白，再用交叉旗确认上下游收到；每个安置点只掌握自己的路线与下一次报平安时刻。",
          "next": "al_line_02",
